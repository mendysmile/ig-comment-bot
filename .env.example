# 這檔案只是 secret 名稱清單參考用,實際不會被 worker 讀取。
# wrangler 從 Cloudflare 的 secret store 讀環境變數,不從本地 .env 檔讀。
# 用法:把以下每一條都跑一次 `wrangler secret put <NAME>`,提示時貼值。

# === Meta IG webhook ===
APP_SECRET=                   # Meta IG 子應用的「Instagram 應用程式密鑰」(雷 6！不是父 App 的)
VERIFY_TOKEN=                 # 自訂隨機字串,用於 Meta webhook 驗證 + 內部 admin 端點驗證

# === IG accounts (JSON array, 一筆一個帳號) ===
IG_ACCOUNTS=                  # 例: [{"username":"your.handle","ig_id":"17841...","token_secret":"ACCOUNT1_TOKEN"}]

# === IG access tokens (每筆 IG_ACCOUNTS[].token_secret 對應一個) ===
ACCOUNT1_TOKEN=               # 從 Meta 後台拿的 IG long-lived access token
# ACCOUNT2_TOKEN=             # 同上,如果你有多個 IG 帳號

# === Notion 規則 DB ===
NOTION_TOKEN=                 # Notion integration token (https://www.notion.so/my-integrations)
NOTION_RULES_DB_ID=           # 規則 DB 的 data source ID (從 Notion DB URL 抓)

# === Privacy Policy 顯示 ===
PRIVACY_OWNER_NAME=           # 例: Your Name
PRIVACY_OWNER_EMAIL=          # 例: you@example.com
PRIVACY_HANDLES=              # 例: @your.handle, @your.other.handle
PRIVACY_LAST_UPDATED=         # 例: 2026-05-05
